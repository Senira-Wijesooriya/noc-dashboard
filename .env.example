# COPY THIS TO .env.local; NEVER COMMIT .env.local OR REAL VALUES.
# Keep your CURRENT Vercel KV connection. Do NOT create a new empty database.
KV_REST_API_URL=https://your-existing-kv-instance.upstash.io
KV_REST_API_TOKEN=YOUR_EXISTING_KV_WRITE_TOKEN

# Dedicated Gmail account with Google 2-Step Verification enabled.
# Use an App Password, NOT your normal Gmail password.
GMAIL_SENDER_EMAIL=shipyard.secure.login@gmail.com
GMAIL_APP_PASSWORD=PASTE_16_CHARACTER_GOOGLE_APP_PASSWORD

# Generate with cryptographically secure randomness; 32+ characters required.
OTP_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Recommended: restrict access to specific approved company users.
# If omitted, ANY owner of an @mitesp.com mailbox can request a code.
SHIPYARD_ALLOWED_EMAILS=engineer1@mitesp.com,engineer2@mitesp.com
